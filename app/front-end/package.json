{
  "name": "meowtro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:weather": "tsc src/map/liveWeather.check.ts --outDir node_modules/.tmp/wcheck --module commonjs --target es2022 --esModuleInterop --skipLibCheck && node node_modules/.tmp/wcheck/liveWeather.check.js",
    "check:sightings": "tsc src/data/sightings.check.ts --outDir node_modules/.tmp/scheck --module commonjs --target es2022 --esModuleInterop --skipLibCheck --resolveJsonModule && node node_modules/.tmp/scheck/data/sightings.check.js"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^6.3.0",
    "motion": "^13.1.0",
    "pmtiles": "^4.5.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
